/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for the paired-end test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Simulated paired-end reads (tests/simulate_pe_reads.py) from the three
    test isolates, with a known truth (test_data/pe/truth.tsv.gz):
      - 2 x 100 bp, reverse-stranded (read 1 antisense), so the default
        --strandedness auto should infer 2 (--rf-stranded)
      - some fragments shorter than the reads (adapter read-through for fastp)
      - four samples: one isolate has two (replicates)
    Reads from the local pipeline directory, not GitHub, so CI tests the data
    on the branch under test.
    Use as follows:
        nextflow run adamd3/PanScript -profile test_pe,<docker/singularity/apptainer/conda> \
            --outdir <OUTDIR>
--------------------------------------------------------------------------------
*/

process.resourceLimits = [cpus: 2, memory: 6.GB, time: 6.h]

params {
    meta_file = "${projectDir}/test_data/pe/meta_pe.tsv"
    gpa_file  = "${projectDir}/test_data/gene_presence_absence.tsv"
    group     = 'isolate'
}
