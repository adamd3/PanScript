/*
 * -------------------------------------------------
 *  Pipeline config
 * -------------------------------------------------
 */

manifest {
    name            = 'adamd3/PanScript'
    homePage        = 'https://github.com/adamd3/PanScript'
    description     = 'Quantify gene expression in bacterial isolates by pseudo-alignment to isolate-specific gene sets, merged through pangenome orthologous groups'
    mainScript      = 'main.nf'
    // Tested in CI on 23.10.1 and the latest release
    nextflowVersion = '>=23.10.0'
    version         = '2.0.0dev'
}

// Global default params
params {
    // Trimming (fastp, default settings; extra options via fastp_args)
    skip_trimming              = false
    save_trimmed               = false
    fastp_args                 = ''

    // Transcript quantification
    fragment_len               = 150 
    fragment_sd                = 20
    strandedness               = 'auto'   // 0, 1, 2 or 'auto' (inferred per sample)

    // Input checks: max fraction of an isolate's Panaroo loci allowed to be
    // missing from its FASTA before the run stops (missing loci are reported
    // in pipeline_info/missing_loci.tsv either way)
    max_missing_loci           = 0.5
    // Number of reads per sample used to check --strandedness (0 = skip check)
    strandedness_check_reads   = 200000

    // Grouping strains (UMAP colouring) and UMAP random seed
    group                      = 'majority_ST'
    seed                       = 42

    // Options: Other
    help                       = false
    outdir                     = './results'
    // How results are saved in outdir (copy is safe to keep after deleting work/)
    publish_dir_mode           = 'copy'

    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                 = '192.GB'
    max_cpus                   = 56
    max_time                   = '10000.h'
}


// Container used by every process (docker, singularity and apptainer profiles).
// Built from environment.yml + Dockerfile; versioned tag, so runs are
// reproducible. Bump the tag (and re-capture tests/baseline) when the
// environment changes.
process.container = 'adamd3/panscript:2.0.0-dev'

// Profiles choose how software is provided. Cluster/site settings (executor,
// queue, resource limits) don't belong here: pass them at run time with
// -c <site.config> (see README, "Running on a cluster").
profiles {
    docker {
        docker {
            enabled            = true
            // run as the calling user, so tasks can write to the work dir on
            // Linux hosts (the image's default user is 'mambauser')
            runOptions         = '-u $(id -u):$(id -g)'
        }
        singularity.enabled    = false
        apptainer.enabled      = false
        podman.enabled         = false
    }
    singularity {
        // image cache: set NXF_SINGULARITY_CACHEDIR (or singularity.cacheDir)
        singularity {
            enabled            = true
            autoMounts         = true
        }
        docker.enabled         = false
        apptainer.enabled      = false
        podman.enabled         = false
    }
    apptainer {
        // image cache: set NXF_APPTAINER_CACHEDIR (or apptainer.cacheDir)
        apptainer {
            enabled            = true
            autoMounts         = true
        }
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
    }
    conda {
        conda.enabled          = true
        process.conda          = "$projectDir/environment.yml"
        conda.createTimeout    = '2 h'
    }
    test {
        includeConfig 'configs/test.config'
    }
}

// Export these variables to prevent local Python/R libraries from 
// conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

// Default configuration for the processes in the pipeline.
// Requests are capped at params.max_cpus / params.max_memory. Written as inline
// closures (no helper function) so the config parses under both older
// Nextflow and the strict config syntax of Nextflow >= 25.
process {
    cpus   = { Math.min(1 * task.attempt, params.max_cpus as int) }
    memory = { [6.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Capture exit codes from upstream processes when piping
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Process-specific resource requirements
    withLabel:process_low {
        cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { [12.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withLabel:process_medium {
        cpus   = { Math.min(6 * task.attempt, params.max_cpus as int) }
        memory = { [36.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withLabel:process_high {
        cpus   = { Math.min(12 * task.attempt, params.max_cpus as int) }
        memory = { [72.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
}
